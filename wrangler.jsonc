// Serves selotape.dev/resume from public/ as a Cloudflare Worker with
// static assets only. Cloudflare's Git integration (Workers Builds) runs
// `wrangler deploy` on every push to main.
{
	"name": "resume",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"routes": [{ "pattern": "selotape.dev/resume*", "zone_name": "selotape.dev" }],
	// The PDF stays at the repo root (old links point at its GitHub raw URL),
	// so the deploy copies it in rather than keeping a second copy in git.
	"build": { "command": "cp 'Ron Visbord - CV.pdf' public/resume.pdf" },
	"assets": { "directory": "./public" }
}
